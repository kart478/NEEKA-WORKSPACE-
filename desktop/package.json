{
  "name": "neeka-desktop",
  "version": "0.2.0",
  "description": "NEEKA Work Engine desktop foundation",
  "main": "dist-electron/electron/main.js",
  "author": "NEEKA",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "package:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^38.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.neeka.workengine",
    "productName": "NEEKA Work Engine",
    "directories": { "output": "release" },
    "files": ["dist-electron/**/*", "dist/**/*", "package.json"],
    "extraResources": [{ "from": "../Component-llamacoder", "to": "backend" }],
    "win": { "target": "nsis", "artifactName": "NEEKA-Setup-${version}.${ext}" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}